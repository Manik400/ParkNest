# Normalise to LF in the repository; Git checks out native line endings on Windows.
* text=auto

*.cs      text diff=csharp
*.md      text
*.json    text
*.yml     text
*.sln     text eol=crlf
*.csproj  text

# Shell scripts must stay LF — CI runs them on Linux, and CRLF breaks the shebang.
*.sh      text eol=lf
*.yml     text eol=lf

*.png binary
*.jpg binary
*.pfx binary
