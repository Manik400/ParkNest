{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ParkNest": "Host=localhost;Port=5432;Database=parknest;Username=parknest;Password=parknest"
  },
  "Auth": {
    "_comment": "Development placeholders. Startup FAILS outside Development while these contain 'dev-only' — supply real secrets via environment variables or a secret store.",
    "SigningKey": "dev-only-signing-key-change-me-at-least-32-chars",
    "OtpPepper": "dev-only-otp-pepper-change-me",
    "Issuer": "parknest",
    "Audience": "parknest-clients",
    "AccessTokenLifetimeMinutes": 720,
    "OtpLifetimeMinutes": 5,
    "OtpMaxAttempts": 5,
    "AdminPhones": []
  },
  "Platform": {
    "CommissionRate": 0.12,
    "BillingIncrementMinutes": 15,
    "MinimumBookingMinutes": 30,
    "OverstayGraceMinutes": 15,
    "MinimumCashOutCredits": 500,
    "MinimumRechargeCredits": 100,
    "MaxOverstayMultiplier": 2.0
  }
}
